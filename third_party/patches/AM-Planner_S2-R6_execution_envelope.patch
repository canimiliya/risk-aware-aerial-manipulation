+  void validateExecutionEnvelope() const
+  {
+    if (!std::isfinite(ExecutionEnvelopeWeight) || ExecutionEnvelopeWeight < 0.0)
+      throw std::invalid_argument("ExecutionEnvelopeWeight must be finite and non-negative");
+    if (!std::isfinite(ExecutionEnvelopeTau) || ExecutionEnvelopeTau <= 0.0)
+      throw std::invalid_argument("ExecutionEnvelopeTau must be finite and positive");
+    if (ExecutionEnvelopeCenters.size() % 3 != 0)
+      throw std::invalid_argument("ExecutionEnvelopeCenters length must be a multiple of 3");
+    const std::size_t count = ExecutionEnvelopeCenters.size() / 3;
+    if (ExecutionEnvelopeRadii.size() != count)
+      throw std::invalid_argument("ExecutionEnvelopeRadii length must equal center count");
+    for (const double value : ExecutionEnvelopeCenters)
+    {
+      if (!std::isfinite(value)) throw std::invalid_argument("ExecutionEnvelopeCenters must be finite");
+    }
+    for (const double radius : ExecutionEnvelopeRadii)
+    {
+      if (!std::isfinite(radius) || radius <= 0.0)
+        throw std::invalid_argument("ExecutionEnvelopeRadii must be finite and positive");
+    }
+    if (UseExecutionEnvelopeBarrier && count == 0)
+      throw std::invalid_argument("enabled execution envelope requires at least one anchor ball");
+  }
